---
import { expeditions, education, honors, toolkit } from '../data/site';
---

<section id="expeditions" class="chapter">
  <div class="chapter-head">
    <span class="chapter-num">Chapter II</span>
    <h2>Expeditions</h2>
    <span class="chapter-note">where I've done the work</span>
  </div>

  <ol class="trail">
    {
      expeditions.map((e, i) => (
        <li class="stop">
          <div class="pin" aria-hidden="true">
            <span>{String(i + 1).padStart(2, '0')}</span>
          </div>
          <article class="entry card">
            <header>
              <div>
                <h3>{e.org}</h3>
                <p class="role">{e.role}</p>
              </div>
              <p class="meta mono">
                {e.dates}
                <br />
                {e.place}
              </p>
            </header>
            <p class="story">{e.story}</p>
            <details open={i < 2}>
              <summary class="mono">{i < 2 ? 'What I did' : 'Details'}</summary>
              <ul class="points">
                {e.points.map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
            </details>
            <div class="tools">
              {e.tools.map((t) => (
                <span class="tag">{t}</span>
              ))}
            </div>
          </article>
        </li>
      ))
    }
  </ol>

  <div class="schooling">
    <div class="card block">
      <h3>Schooling</h3>
      <ul class="plain">
        {
          education.map((ed) => (
            <li>
              <strong>{ed.school}</strong>
              <span class="mono small"> · {ed.dates}</span>
              <br />
              {ed.degree}
              <br />
              <span class="mono small accent">{ed.detail}</span>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="card block">
      <h3>Ribbons &amp; badges</h3>
      <ul class="plain ribbons">
        {honors.map((h) => <li>{h}</li>)}
      </ul>
    </div>
    <div class="card block toolkit">
      <h3>Toolkit</h3>
      {
        toolkit.map((t) => (
          <div class="tool-group">
            <p class="mono small group">{t.group}</p>
            <div class="tools">
              {t.items.map((i) => (
                <span class="tag">{i}</span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .trail {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
  }
  .trail::before {
    content: '';
    position: absolute;
    left: 22px;
    top: 10px;
    bottom: 10px;
    border-left: 2px dashed var(--rule);
  }
  .stop {
    display: grid;
    grid-template-columns: 46px 1fr;
    gap: 18px;
    margin-bottom: 26px;
  }
  .pin {
    position: relative;
    z-index: 1;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--paper);
    border: 2px solid var(--sage);
    display: grid;
    place-items: center;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--sage);
  }
  .entry {
    padding: 22px 24px;
    min-width: 0;
  }
  .entry header {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  h3 {
    font-size: 1.55rem;
    margin: 0;
  }
  .role {
    margin: 2px 0 0;
    font-style: italic;
    color: var(--ink-soft);
  }
  .meta {
    text-align: right;
    font-size: 0.78rem;
    color: var(--ink-faint);
    margin: 0;
  }
  .story {
    margin: 14px 0 10px;
    font-size: 1.05rem;
  }
  summary {
    cursor: pointer;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sage);
    margin-bottom: 8px;
  }
  .points {
    margin: 0 0 12px;
    padding-left: 20px;
    color: var(--ink-soft);
  }
  .points li {
    margin-bottom: 6px;
  }
  .points li::marker {
    content: '❧  ';
    color: var(--sage);
  }
  .tools {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .schooling {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 20px;
    margin-top: 44px;
  }
  .block {
    padding: 22px 24px;
  }
  .block h3 {
    font-size: 1.3rem;
    margin-bottom: 12px;
  }
  .plain {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .plain li {
    margin-bottom: 14px;
    line-height: 1.5;
  }
  .ribbons li::before {
    content: '✿ ';
    color: var(--rose);
  }
  .small {
    font-size: 0.78rem;
    color: var(--ink-faint);
  }
  .accent {
    color: var(--sage);
  }
  .tool-group {
    margin-bottom: 12px;
  }
  .group {
    margin: 0 0 6px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  @media (max-width: 560px) {
    .stop {
      grid-template-columns: 1fr;
    }
    .pin,
    .trail::before {
      display: none;
    }
    .meta {
      text-align: left;
    }
  }
</style>
