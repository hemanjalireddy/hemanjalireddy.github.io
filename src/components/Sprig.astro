---
// Hand-drawn style botanical ornaments. Colour follows currentColor.
interface Props {
  kind?: 'fern' | 'branch' | 'flower' | 'divider';
  size?: number;
  class?: string;
}
const { kind = 'branch', size = 64, class: cls = '' } = Astro.props;
---

{
  kind === 'fern' && (
    <svg class={`sprig ${cls}`} width={size} height={size * 1.6} viewBox="0 0 60 96" aria-hidden="true">
      <path d="M30 94 C30 70 29 40 31 4" stroke="currentColor" stroke-width="1.4" fill="none" stroke-linecap="round" />
      {[12, 22, 32, 42, 52, 62, 72].map((y, i) => {
        const w = 22 - i * 2.2;
        return (
          <>
            <path d={`M30.5 ${y + 6} C${30 - w * 0.6} ${y + 2} ${30 - w} ${y - 2} ${30 - w} ${y - 6} C${30 - w * 0.5} ${y - 4} ${30 - 3} ${y} 30.5 ${y + 6}Z`} fill="currentColor" opacity="0.75" />
            <path d={`M30.5 ${y + 3} C${30 + w * 0.6} ${y - 1} ${30 + w} ${y - 5} ${30 + w} ${y - 9} C${30 + w * 0.5} ${y - 7} ${30 + 3} ${y - 3} 30.5 ${y + 3}Z`} fill="currentColor" opacity="0.6" />
          </>
        );
      })}
    </svg>
  )
}
{
  kind === 'branch' && (
    <svg class={`sprig ${cls}`} width={size} height={size} viewBox="0 0 80 80" aria-hidden="true">
      <path d="M6 74 C24 60 44 40 74 8" stroke="currentColor" stroke-width="1.4" fill="none" stroke-linecap="round" />
      <path d="M22 61 C14 54 12 46 14 40 C22 44 25 52 22 61Z" fill="currentColor" opacity="0.7" />
      <path d="M26 57 C34 58 41 54 44 48 C36 46 29 50 26 57Z" fill="currentColor" opacity="0.55" />
      <path d="M40 42 C34 34 34 26 37 20 C44 26 44 34 40 42Z" fill="currentColor" opacity="0.7" />
      <path d="M45 37 C53 38 60 33 62 27 C54 25 48 30 45 37Z" fill="currentColor" opacity="0.55" />
      <path d="M58 22 C55 15 57 9 61 5 C65 11 63 17 58 22Z" fill="currentColor" opacity="0.7" />
    </svg>
  )
}
{
  kind === 'flower' && (
    <svg class={`sprig ${cls}`} width={size} height={size * 1.4} viewBox="0 0 60 84" aria-hidden="true">
      <path d="M30 82 C30 64 31 46 30 26" stroke="currentColor" stroke-width="1.4" fill="none" stroke-linecap="round" />
      <path d="M30 60 C22 56 18 50 18 44 C25 46 29 52 30 60Z" fill="currentColor" opacity="0.6" />
      <path d="M30 50 C38 46 42 40 42 34 C35 36 31 42 30 50Z" fill="currentColor" opacity="0.5" />
      <g style="color: var(--rose)">
        {[0, 72, 144, 216, 288].map((a) => (
          <ellipse cx="30" cy="12" rx="5" ry="9" fill="currentColor" opacity="0.75" transform={`rotate(${a} 30 20)`} />
        ))}
      </g>
      <circle cx="30" cy="20" r="3.5" fill="var(--gold)" />
    </svg>
  )
}
{
  kind === 'divider' && (
    <svg class={`sprig ${cls}`} width="100%" height="28" viewBox="0 0 400 28" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
      <path d="M40 14 H170 M230 14 H360" stroke="currentColor" stroke-width="1" stroke-dasharray="2 5" />
      <path d="M200 4 C192 8 190 14 200 24 C210 14 208 8 200 4Z" fill="currentColor" opacity="0.7" />
      <path d="M186 14 C180 10 174 10 170 14 C174 18 180 18 186 14Z" fill="currentColor" opacity="0.5" />
      <path d="M214 14 C220 10 226 10 230 14 C226 18 220 18 214 14Z" fill="currentColor" opacity="0.5" />
    </svg>
  )
}
